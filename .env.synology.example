# AudioServer - Synology NAS deployment
# Copy this to .env on the NAS (/volume1/docker/AudioServer/.env) and fill in
# your values. Never commit the filled-in copy: .env and .env.* are ignored.

# Music library path on Synology (check your shared folder name)
MUSIC_PATH=/volume1/music

# Security - generate with: openssl rand -hex 32 (at least 32 characters;
# the server refuses to start in production with anything shorter)
JWT_SECRET=

# Spotify (from developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Tidal (from developer.tidal.com)
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Spotify login for Librespot (your Spotify account, not the API keys)
SPOTIFY_USERNAME=
SPOTIFY_PASSWORD=

# Qobuz playback (app credentials are required for full-track playback)
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=
# 5 = MP3 320, 6 = FLAC 16/44.1, 7 = FLAC 24/96, 27 = FLAC 24/192
QOBUZ_AUDIO_FORMAT=5

# Qobuz account credentials are optional. If omitted, login via Settings.
QOBUZ_USERNAME=
QOBUZ_PASSWORD=

# Known DLNA devices on your network (host:port, comma-separated)
# DLNA_DEVICES=192.168.1.20:49152,192.168.1.21:1400
DLNA_DEVICES=

# Volumio devices (host, port defaults to 3000)
# VOLUMIO_DEVICES=192.168.1.30
VOLUMIO_DEVICES=
