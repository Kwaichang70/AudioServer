{
  "name": "audioserver",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "npm test --workspace=server && npm test --workspace=client",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.4"
  },
  "overrides": {
    "qs": "^6.16.1",
    "shell-quote": "^1.11.0",
    "body-parser@^1": "^1.20.9",
    "undici@^7": "^7.30.1",
    "ip-address": "^10.7.4",
    "fast-uri@^3": "^3.1.9",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser@^6": "^6.1.5",
    "brace-expansion@^1": "^1.1.21",
    "brace-expansion@^5": "^5.0.12"
  }
}
