{
  "name": "@audioserver/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "db:backup": "node run-script.mjs db-backup",
    "bench:search": "node run-script.mjs search-bench",
    "bench:scan": "node run-script.mjs scan-bench",
    "db:verify": "node run-script.mjs db-verify",
    "db:restore": "node run-script.mjs db-restore",
    "user:password": "node run-script.mjs user-password",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@audioserver/shared": "*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multicast-dns": "^7.2.5",
    "music-metadata": "^11.16.1",
    "node-ssdp": "^4.0.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "xml2js": "^0.6.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multicast-dns": "^7.2.4",
    "@types/node-ssdp": "^4.0.5",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "vitest": "^4.1.12"
  }
}
