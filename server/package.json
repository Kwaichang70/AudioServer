{
  "name": "@audioserver/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm --watch src/index.ts",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:backup": "node --import tsx/esm src/scripts/db-backup.ts",
    "bench:search": "node --import tsx/esm src/scripts/search-bench.ts",
    "db:verify": "node --import tsx/esm src/scripts/db-verify.ts",
    "db:restore": "node --import tsx/esm src/scripts/db-restore.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@audioserver/shared": "*",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "music-metadata": "^11.15.0",
    "node-ssdp": "^4.0.1",
    "socket.io": "^4.8.1",
    "tsx": "^4.23.13",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-ssdp": "^4.0.5",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "vitest": "^4.1.2"
  }
}
