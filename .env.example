# Server
PORT=3001
NODE_ENV=development

# Music library paths (comma-separated)
MUSIC_LIBRARY_PATHS=/mnt/nas/music

# Database
DATABASE_PATH=./data/audioserver.db

# Logging
# Development defaults to text/debug; production defaults to json/info.
# LOG_FORMAT=text
# LOG_LEVEL=debug

# Auth (generate a random secret: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret

# Reverse proxy: which X-Forwarded-* headers to believe (Express "trust proxy").
# loopback = a proxy on the same host (Synology reverse proxy with host
# networking); false = nothing in front; a hop count or IP list otherwise.
# TRUST_PROXY=loopback
# Optional: fixed first-run setup code (otherwise generated and printed to the
# log + written to setup-code.txt next to the database). Only used while the
# installation has no accounts.
# SETUP_CODE=

# Server-driven playback on DLNA/Sonos/Volumio (V04)
# What to do when the NAS reaches a track it cannot play on the speaker
# (Tidal, Spotify without an app open, Qobuz not logged in): skip (default,
# max 3 in a row) or stop with a visible error.
# PLAYBACK_UNPLAYABLE_POLICY=skip
# After a server restart, start the current track again when the speaker is
# idle. Default false: the queue is restored, playback waits for a tap.
# PLAYBACK_RESUME_ON_RESTART=false

# Scrobbling (V05): listens are measured server-side; a listen qualifies once
# at least half the track (or 4 minutes) was actually heard. Spotify listens
# are recorded in history but not submitted to Last.fm/ListenBrainz unless
# set to true (Spotify usually scrobbles those itself: double submissions).
# SCROBBLE_SPOTIFY=false

# Library watcher (V06.3): rescan automatically a few seconds after files
# change under MUSIC_LIBRARY_PATHS. Off by default; on Synology/SMB shares
# inotify events may not arrive, then a manual or scheduled scan is the way.
# WATCH_LIBRARY=false

# Unified search (V07.4): time budget per streaming source; a slower source
# is reported as "no answer" and the other results are shown anyway.
# SEARCH_PROVIDER_TIMEOUT_MS=6000

# Known DLNA/UPnP devices to probe directly (fallback when SSDP is blocked)
# Comma-separated host:port pairs
# DLNA_DEVICES=192.168.2.42:49152,192.168.2.27:1400

# Tidal (future)
# TIDAL_CLIENT_ID=
# TIDAL_CLIENT_SECRET=

# Spotify (future)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Qobuz playback (robust mode: explicit app credentials required)
# QOBUZ_APP_ID=
# QOBUZ_APP_SECRET=
# Optional: login automatically on server start. Otherwise login via Settings.
# QOBUZ_USERNAME=
# QOBUZ_PASSWORD=
# 5 = MP3 320, 6 = FLAC 16/44.1, 7 = FLAC 24/96, 27 = FLAC 24/192
QOBUZ_AUDIO_FORMAT=5
